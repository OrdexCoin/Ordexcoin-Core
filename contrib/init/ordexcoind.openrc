#!/sbin/openrc-run

# backward compatibility for existing gentoo layout 
#
if [ -d "/var/lib/ordexcoin/.ordexcoin" ]; then
	ORDEXCOIND_DEFAULT_DATADIR="/var/lib/ordexcoin/.ordexcoin"
else
	ORDEXCOIND_DEFAULT_DATADIR="/var/lib/ordexcoind"
fi

ORDEXCOIND_CONFIGFILE=${ORDEXCOIND_CONFIGFILE:-/etc/ordexcoin/ordexcoin.conf}
ORDEXCOIND_PIDDIR=${ORDEXCOIND_PIDDIR:-/var/run/ordexcoind}
ORDEXCOIND_PIDFILE=${ORDEXCOIND_PIDFILE:-${ORDEXCOIND_PIDDIR}/ordexcoind.pid}
ORDEXCOIND_DATADIR=${ORDEXCOIND_DATADIR:-${ORDEXCOIND_DEFAULT_DATADIR}}
ORDEXCOIND_USER=${ORDEXCOIND_USER:-${ORDEXCOIN_USER:-ordexcoin}}
ORDEXCOIND_GROUP=${ORDEXCOIND_GROUP:-ordexcoin}
ORDEXCOIND_BIN=${ORDEXCOIND_BIN:-/usr/bin/ordexcoind}
ORDEXCOIND_NICE=${ORDEXCOIND_NICE:-${NICELEVEL:-0}}
ORDEXCOIND_OPTS="${ORDEXCOIND_OPTS:-${ORDEXCOIN_OPTS}}"

name="OrdexCoin Core Daemon"
description="OrdexCoin cryptocurrency P2P network daemon"

command="/usr/bin/ordexcoind"
command_args="-pid=\"${ORDEXCOIND_PIDFILE}\" \
		-conf=\"${ORDEXCOIND_CONFIGFILE}\" \
		-datadir=\"${ORDEXCOIND_DATADIR}\" \
		-daemon \
		${ORDEXCOIND_OPTS}"

required_files="${ORDEXCOIND_CONFIGFILE}"
start_stop_daemon_args="-u ${ORDEXCOIND_USER} \
			-N ${ORDEXCOIND_NICE} -w 2000"
pidfile="${ORDEXCOIND_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${ORDEXCOIND_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${ORDEXCOIND_USER}:${ORDEXCOIND_GROUP}" \
	"${ORDEXCOIND_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${ORDEXCOIND_USER}:${ORDEXCOIND_GROUP}" \
	"${ORDEXCOIND_PIDDIR}"

	checkpath -f \
	-o "${ORDEXCOIND_USER}:${ORDEXCOIND_GROUP}" \
	-m 0660 \
	"${ORDEXCOIND_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if grep -qs '^rpcuser=' "${ORDEXCOIND_CONFIGFILE}" && \
		! grep -qs '^rpcpassword=' "${ORDEXCOIND_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run ordexcoind."
		eerror "The setting must appear in ${ORDEXCOIND_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"OrdexCoin Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
